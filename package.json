{
  "name": "server-v2",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch ./src",
    "build": "tsc --noEmit",
    "start": "tsx ./src",
    "start:prod": "NODE_ENV=production tsx ./src",
    "g": "npx drizzle-kit generate",
    "m": "npx drizzle-kit migrate",
    "seed:comprehensive": "tsx scripts/seed_comprehensive.ts",
    "seed:test": "tsx scripts/seed_test_data.ts",
    "seed:demo": "tsx src/db/seedDemo.ts",
    "migrate:clerk": "tsx scripts/migrateToClerk.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:unit": "vitest run --grep 'unit'",
    "test:integration": "vitest run --grep 'integration'",
    "test:e2e": "vitest run --grep 'e2e'"
  },
  "keywords": [],
