# Database Configuration
# PostgreSQL connection string. Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/ventory

# Server Configuration
# Port the Express server will listen on (default: 3030)
PORT=3030

# Environment Mode
# Options: development, production, test
NODE_ENV=development

# JWT Configuration
# Secret key for signing JWT tokens. Generate a strong random string for production.
# On Linux/Mac: openssl rand -hex 32
JWT_SECRET=your-secret-key-change-this-in-production

# CORS Configuration
# Comma-separated list of allowed origins for CORS requests
# Example: http://localhost:3001,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:3001

# Logging Configuration
# Log level: trace, debug, info, warn, error, fatal (default: info)
LOG_LEVEL=info

# Client URL
# Base URL of the frontend app, used to build links in outbound emails
# (invitations, password resets, magic links, invoice review links).
CLIENT_URL=http://localhost:3001

# Resend (outbound email + inbound invoice-email webhook)
# https://resend.com/api-keys — leave unset in development to log emails
# to the console instead of sending them.
RESEND_API_KEY=
# Must be a domain verified in your Resend account.
RESEND_FROM_EMAIL=noreply@yourdomain.com
# Signing secret for the Resend inbound webhook (Svix-based). Required in
# production — requests are rejected without it. Optional in development
# (unsigned requests are allowed through).
RESEND_INBOUND_WEBHOOK_SECRET=

# Gemini AI (invoice data extraction from emailed PDFs/images)
# https://aistudio.google.com/apikey — invoice extraction is disabled
# without this set.
GEMINI_API_KEY=

# Cloudflare R2 (invoice file storage)
# Required for storing the original invoice files ingested via the Resend
# webhook. File uploads are skipped (with a warning) if unset.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
